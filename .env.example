# Copy this to .env for local `netlify dev` use. In production, set these as
# environment variables in the Netlify dashboard (Site settings > Environment
# variables) instead -- never commit a real .env file.

# Firecrawl API key (also used by the Python scripts). Get it/check usage at
# https://firecrawl.dev -- Dashboard > API Keys.
FIRECRAWL_API_KEY=

# Google Cloud Console > APIs & Services > Credentials > OAuth client ID
# (Application type: Web application). Redirect URI must be:
#   http://127.0.0.1:8888/auth/callback           (local `netlify dev`)
#   https://<your-site>.netlify.app/auth/callback  (production)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Random secret used to sign session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Never reuse this across environments; rotating it logs everyone out.
JWT_SECRET=

# Comma-separated list of the exact Google account emails allowed to sign
# in -- this is the REAL access-control check, not Google's own "Test
# users" list in the OAuth consent screen (that list only gates who can
# reach the consent screen while the app is unverified, caps at 100 users,
# and stops being enforced at all if the app is ever published). Keep this
# list and the Google Console "Test users" list in sync manually.
ALLOWED_EMAILS=you@example.com,friend@example.com
